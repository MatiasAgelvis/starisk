# Everything the nightly job needs. Copy to `ops/.env` and fill it in.
# None of this is read by the site: these are server-side secrets, and they stay
# on the box.

# Turso: the request queue (course_requests). Same database the site writes to.
TURSO_DATABASE_URL=libsql://...
TURSO_AUTH_TOKEN=

# Fine-grained PAT, this repository only:
#   Contents: read and write
#   Pull requests: read and write
GITHUB_TOKEN=

# ntfy topic URL, e.g. https://ntfy.sh/starisk-a-random-suffix
NTFY_URL=

# Only needed for a protected topic.
NTFY_TOKEN=

# Optional. The container clones this repository into its volume; the default is
# the public repo, so this is only needed for a fork.
# GITHUB_REPO=MatiasAgelvis/starisk
