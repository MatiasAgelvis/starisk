---
import Base from '../layouts/Base.astro';
import requests from '../data/requests.json';
import scores from '../data/scores.json';
import groupings from '../data/groupings.json';
import { buildWanted } from '../lib/wanted.js';

type WantedRow = {
  anchor: string;
  label: string;
  href: string;
  title: string;
  external: boolean;
  showKey: boolean;
  key: string;
  query?: string | null;
  requests: number;
  first_seen?: string | null;
  added_at?: string | null;
  scoredAt?: string | null;
  summary: string;
};

const { waiting, fulfilled } = buildWanted(requests, scores, groupings) as {
  waiting: WantedRow[];
  fulfilled: WantedRow[];
};
const recent = fulfilled.slice(0, 12);

const date = (value?: string | null) =>
  value
    ? new Intl.DateTimeFormat('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      }).format(new Date(value))
    : null;

const asks = (count: number) => `${count} ${count === 1 ? 'ask' : 'asks'}`;
---

<Base
  title="Wanted — Starisk"
  description="Courses and programs readers asked Starisk to score, and what came of it."
>
  <article class="mx-auto max-w-3xl">
    <header>
      <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Wanted</h1>
      <p class="mt-3 max-w-2xl text-base-content/75">
        Courses and programs people asked Starisk to score — and what came of it.
      </p>
      <p class="mt-2 text-sm text-base-content/60">
        Checked nightly. Requests appear here after the check; there is no ETA.
      </p>
    </header>

    <section class="mt-10">
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="font-display text-xl font-bold">Waiting</h2>
        <p class="text-sm text-base-content/60">{waiting.length} in the crawl list</p>
      </div>

      {
        waiting.length > 0 ? (
          <ul class="mt-4 divide-y divide-base-300 overflow-hidden rounded-box border border-base-300">
            {waiting.map((row) => (
              <li
                id={row.anchor}
                class="flex flex-wrap items-baseline gap-x-3 gap-y-1 p-4"
              >
                <span class="badge badge-ghost badge-sm">{row.label}</span>
                <a
                  class="link link-hover font-medium"
                  href={row.href}
                  target={row.external ? '_blank' : undefined}
                  rel={row.external ? 'noopener noreferrer' : undefined}
                >
                  {row.title}
                  {row.external ? ' ↗' : ''}
                </a>
                {row.showKey ? (
                  <span class="font-mono text-xs text-base-content/50">{row.key}</span>
                ) : null}
                <span class="ml-auto flex flex-wrap items-baseline gap-x-3 text-sm text-base-content/60">
                  <span>{asks(row.requests)}</span>
                  {date(row.added_at) ? <span>added {date(row.added_at)}</span> : null}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4 rounded-box border border-base-300 p-4 text-sm text-base-content/60">
            Nothing waiting. The lookup on the <a class="link link-hover" href="/">home page</a> is
            the way in.
          </p>
        )
      }
    </section>

    {
      recent.length > 0 && (
        <section class="mt-12">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="font-display text-xl font-bold">Recently fulfilled</h2>
            <a class="text-sm text-base-content/60 link link-hover" href="/feed.xml">
              Follow by RSS →
            </a>
          </div>

          <ul class="mt-4 divide-y divide-base-300 overflow-hidden rounded-box border border-base-300">
            {recent.map((row) => (
              <li
                id={row.anchor}
                class="flex flex-wrap items-baseline gap-x-3 gap-y-1 p-4"
              >
                <span class="badge badge-ghost badge-sm">{row.label}</span>
                <a
                  class="link link-hover font-medium"
                  href={row.href}
                  target={row.external ? '_blank' : undefined}
                  rel={row.external ? 'noopener noreferrer' : undefined}
                >
                  {row.title}
                  {row.external ? ' ↗' : ''}
                </a>
                <span class="ml-auto flex flex-wrap items-baseline gap-x-3 text-sm text-base-content/60">
                  <span>{row.summary}</span>
                  {date(row.scoredAt ?? row.added_at) ? (
                    <span>{date(row.scoredAt ?? row.added_at)}</span>
                  ) : null}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      requests.generatedAt && (
        <p class="mt-8 text-xs text-base-content/40">
          Ask list from {date(requests.generatedAt)}.
        </p>
      )
    }
  </article>
</Base>
