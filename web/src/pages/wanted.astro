---
import Base from '../layouts/Base.astro';
import requests from '../data/requests.json';
import scores from '../data/scores.json';
import groupings from '../data/groupings.json';
import sources from '../data/sources.json';
import retired from '../data/retired.json';
import { buildCrawlStats, buildRecent, buildWanted } from '../lib/wanted.js';

type WantedRow = {
  anchor: string;
  label: string;
  href: string;
  title: string;
  external: boolean;
  showKey: boolean;
  key: string;
  query?: string | null;
  requests: number;
  first_seen?: string | null;
  added_at?: string | null;
  scoredAt?: string | null;
  summary: string;
};

const { waiting, fulfilled } = buildWanted(requests, scores, groupings) as {
  waiting: WantedRow[];
  fulfilled: WantedRow[];
};
const recent = fulfilled.slice(0, 12);
const newest = buildRecent(scores, 10);
const stats = buildCrawlStats(scores, sources, retired);

const date = (value?: string | null) =>
  value
    ? new Intl.DateTimeFormat('en-GB', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      }).format(new Date(value))
    : null;

const asks = (count: number) => `${count} ${count === 1 ? 'ask' : 'asks'}`;
---

<Base
  title="Wanted — Starisk"
  description="Courses and programs readers asked Starisk to score, and what came of it."
>
  <article class="mx-auto max-w-3xl">
    <header>
      <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Wanted</h1>
      <p class="mt-3 max-w-2xl text-base-content/75">
        Courses and programs people asked Starisk to score — and what came of it.
      </p>
      <div class="stats stats-vertical sm:stats-horizontal mt-6 w-full border border-base-300">
        <div class="stat">
          <div class="stat-title">Last crawl</div>
          <div class="stat-value text-lg">{stats.lastRead ? date(stats.lastRead) : '—'}</div>
          <div class="stat-desc">{stats.lastRead ? 'newest read in the corpus' : 'no crawl yet'}</div>
        </div>
        <div class="stat">
          <div class="stat-title">Read in that run</div>
          <div class="stat-value text-lg">{stats.readInRun.toLocaleString('en-GB')}</div>
          <div class="stat-desc">new and rescored</div>
        </div>
        <div class="stat">
          <div class="stat-title">Scored</div>
          <div class="stat-value text-lg">{stats.scored.toLocaleString('en-GB')}</div>
          <div class="stat-desc">of {stats.read.toLocaleString('en-GB')} read</div>
        </div>
        <div class="stat">
          <div class="stat-title">Still to read</div>
          <div class="stat-value text-lg">{stats.queued.toLocaleString('en-GB')}</div>
          <div class="stat-desc">in the crawl queue</div>
        </div>
      </div>
      <p class="mt-2 text-sm text-base-content/60">
        Checked nightly. Requests appear here after the check; there is no ETA. For the courses we
        have already read, <a class="link link-hover" href="/bookmarklet">the score is also on
        Coursera's own pages</a>.
      </p>
    </header>

    {
      waiting.length > 0 ? (
        <section class="mt-10">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="font-display text-xl font-bold">Waiting</h2>
            <p class="text-sm text-base-content/60">{waiting.length} in the crawl list</p>
          </div>

          <ul class="mt-4 divide-y divide-base-300 overflow-hidden rounded-box border border-base-300">
            {waiting.map((row) => (
              <li
                id={row.anchor}
                class="flex flex-wrap items-baseline gap-x-3 gap-y-1 p-4"
              >
                <span class="badge badge-ghost badge-sm">{row.label}</span>
                <a
                  class="link link-hover font-medium"
                  href={row.href}
                  target={row.external ? '_blank' : undefined}
                  rel={row.external ? 'noopener noreferrer' : undefined}
                >
                  {row.title}
                  {row.external ? ' ↗' : ''}
                </a>
                {row.showKey ? (
                  <span class="font-mono text-xs text-base-content/50">{row.key}</span>
                ) : null}
                <span class="ml-auto flex flex-wrap items-baseline gap-x-3 text-sm text-base-content/60">
                  <span>{asks(row.requests)}</span>
                  {date(row.added_at) ? <span>added {date(row.added_at)}</span> : null}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <p class="mt-8 text-sm text-base-content/60">
          Nothing waiting right now. Paste a Coursera link on the{' '}
          <a class="link link-hover" href="/">home page</a> to ask for a course — it lands here
          after the next nightly check.
        </p>
      )
    }

    {
      newest.length > 0 && (
        <section class="mt-12">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="font-display text-xl font-bold">Recently added</h2>
            <p class="text-sm text-base-content/60">Newest scores in the corpus</p>
          </div>

          <ul class="mt-4 divide-y divide-base-300 overflow-hidden rounded-box border border-base-300">
            {newest.map((row) => (
              <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 p-4">
                <a class="link link-hover font-medium" href={row.href}>{row.title}</a>
                {row.provider ? (
                  <span class="text-sm text-base-content/50">{row.provider}</span>
                ) : null}
                <span class="ml-auto flex flex-wrap items-baseline gap-x-3 text-sm text-base-content/60">
                  <span>{row.summary}</span>
                  {date(row.scrapedAt) ? <span>{date(row.scrapedAt)}</span> : null}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      recent.length > 0 && (
        <section class="mt-12">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="font-display text-xl font-bold">Recently fulfilled</h2>
            <a class="text-sm text-base-content/60 link link-hover" href="/feed.xml">
              Follow by RSS →
            </a>
          </div>

          <ul class="mt-4 divide-y divide-base-300 overflow-hidden rounded-box border border-base-300">
            {recent.map((row) => (
              <li
                id={row.anchor}
                class="flex flex-wrap items-baseline gap-x-3 gap-y-1 p-4"
              >
                <span class="badge badge-ghost badge-sm">{row.label}</span>
                <a
                  class="link link-hover font-medium"
                  href={row.href}
                  target={row.external ? '_blank' : undefined}
                  rel={row.external ? 'noopener noreferrer' : undefined}
                >
                  {row.title}
                  {row.external ? ' ↗' : ''}
                </a>
                <span class="ml-auto flex flex-wrap items-baseline gap-x-3 text-sm text-base-content/60">
                  <span>{row.summary}</span>
                  {date(row.scoredAt ?? row.added_at) ? (
                    <span>{date(row.scoredAt ?? row.added_at)}</span>
                  ) : null}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      requests.generatedAt && (
        <p class="mt-8 text-xs text-base-content/40">
          Ask list unchanged since {date(requests.generatedAt)} — checked on every crawl.
        </p>
      )
    }
  </article>
</Base>
