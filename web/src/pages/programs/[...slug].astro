---
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import ScoreTable from '../../components/ScoreTable.svelte';
import Stars from '../../components/Stars.astro';
import { buildGroupings, typeLabel } from '../../lib/groupings.js';
import scores from '../../data/scores.json';
import groupings from '../../data/groupings.json';

export function getStaticPaths() {
  return buildGroupings(groupings, scores).map((program) => ({
    params: { slug: program.key },
    props: { program },
  }));
}

const { program } = Astro.props;
const average = program.average;
const type = typeLabel(program.type);
const description =
  average == null
    ? `${program.title}: ${program.total} courses, none with written reviews yet.`
    : `${program.title}: ${program.scored} courses averaged at ${average.toFixed(1)} out of 5.`;
---

<Base title={`${program.title} — Starisk`} description={description}>
  <article class="mx-auto max-w-3xl">
    <BackLink fallback="/programs" />

    <header class="mt-4">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="font-display text-3xl font-bold tracking-tight">{program.title}</h1>
        <span class="badge badge-ghost badge-sm">{type}</span>
      </div>
      <p class="mt-1 text-sm text-base-content/60">
        {program.provider ?? 'Unknown provider'} ·{' '}
        <a
          class="link link-hover"
          href={program.url}
          target="_blank"
          rel="noopener noreferrer">View on Coursera ↗</a
        >
      </p>
    </header>

    {
      !program.complete && (
        <div class="alert alert-warning mt-6 text-sm">
          <span>
            <strong>Partial set.</strong> {program.total - program.scored} of {program.total}{' '}
            courses have no Starisk score, so this program is hidden from the default directory.
          </span>
        </div>
      )
    }

    <div class="stats stats-vertical mt-6 w-full shadow sm:stats-horizontal">
      <div class="stat">
        <div class="stat-title">Starisk average</div>
        <div class="stat-value text-2xl">{average == null ? '—' : average.toFixed(1)}</div>
        {average == null ? null : <Stars value={average} size={16} />}
        <div class="stat-desc">across {program.scored} scored courses</div>
      </div>
      {
        program.programRating != null && (
          <div class="stat">
            <div class="stat-title">Program page (Starisk)</div>
            <div class="stat-value text-2xl">{program.programRating.toFixed(1)}</div>
            <Stars value={program.programRating} size={16} />
            <div class="stat-desc">from its own reviews</div>
          </div>
        )
      }
    </div>

    {
      program.low != null && (
        <p class="mt-3 text-sm text-base-content/60">
          Starisk course range: {program.low.toFixed(1)}–{program.high.toFixed(1)}.
        </p>
      )
    }

    <section class="mt-8">
      <h2 class="font-display text-xl font-bold">
        The {program.total === 1 ? 'course' : 'courses'}
      </h2>
      <div class="mt-4">
        <ScoreTable
          rows={program.courses}
          showFilters={false}
          compact={true}
          defaultSortKey="starisk"
        />
      </div>
    </section>

    <section class="mt-10 space-y-3 text-sm text-base-content/60">
      <p>
        {program.scored} of {program.total} courses are scored. The average weights each course by
        the reviews we read, so a course with four readable reviews does not pull as hard as one
        with twenty. It is still a small sample: {program.reviews} reviews in total.
      </p>
      {
        program.programRating != null && (
          <p>
            The program page's own reviews give it a Starisk score of{' '}
            <strong>{program.programRating.toFixed(1)}</strong>; the average of its courses is{' '}
            <strong>{average == null ? '—' : average.toFixed(1)}</strong>. The gap is the point —
            the bundle can rate differently from the parts.
          </p>
        )
      }
      <p>
        This is the same measurement as everywhere else on the site — what the most-upvoted reviews
        say — not a verdict on the program as a product.
        <a class="link link-hover" href="/method">The method.</a>
      </p>
    </section>
  </article>
</Base>
