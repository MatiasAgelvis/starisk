---
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import ScoreTable from '../../components/ScoreTable.svelte';
import ScoreGap from '../../components/ScoreGap.astro';
import Stars from '../../components/Stars.astro';
import { verdictOf, VERDICT } from '../../lib/verdict.js';
import { buildGroupings, typeLabel } from '../../lib/groupings.js';
import scores from '../../data/scores.json';
import groupings from '../../data/groupings.json';

export function getStaticPaths() {
  return buildGroupings(groupings, scores).map((program) => ({
    params: { slug: program.key },
    props: { program },
  }));
}

const { program } = Astro.props;
const average = program.average;
const type = typeLabel(program.type);
const verdict =
  program.programRating == null
    ? ''
    : VERDICT[verdictOf(program.programCoursera, program.programRating)].label;
const description =
  average == null
    ? `${program.title}: ${program.total} courses, none with written reviews yet.`
    : `${program.title}: ${program.scored} courses averaged at ${average.toFixed(1)} out of 5.`;
---

<Base title={`${program.title} — Starisk`} description={description}>
  <article class="mx-auto max-w-3xl">
    <BackLink fallback="/programs" />

    <header class="mt-4">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="font-display text-3xl font-bold tracking-tight">{program.title}</h1>
        <span class="badge badge-ghost badge-sm">{type}</span>
      </div>
      <p class="mt-1 text-sm text-base-content/60">
        {program.provider ?? 'Unknown provider'} ·{' '}
        <a
          class="link link-hover"
          href={program.url}
          target="_blank"
          rel="noopener noreferrer">View on Coursera ↗</a
        >
      </p>
    </header>

    {
      !program.complete && (
        <div class="alert alert-warning mt-6 text-sm">
          <span>
            <strong>Partial set.</strong> {program.total - program.scored} of {program.total}{' '}
            courses have no Starisk score, so this program is hidden from the default directory.
          </span>
        </div>
      )
    }

    {
      program.programRating != null ? (
        <div class="mt-6">
          <ScoreGap
            coursera={program.programCoursera}
            starisk={program.programRating}
            verdict={verdict}
          />
        </div>
      ) : (
        <div class="mt-6 rounded-box border border-base-300 bg-base-200/50 p-5">
          <div class="text-xs font-semibold uppercase tracking-wide text-base-content/50">
            Course average
          </div>
          <div class="mt-1 flex items-baseline gap-2">
            <span class="font-display text-3xl font-bold">
              {average == null ? '—' : average.toFixed(1)}
            </span>
            {average == null ? null : <Stars value={average} size={16} />}
          </div>
          <div class="text-xs text-base-content/50">across {program.scored} scored courses</div>
        </div>
      )
    }

    <section class="mt-8">
      <h2 class="font-display text-xl font-bold">
        The {program.total === 1 ? 'course' : 'courses'}
      </h2>
      <div class="mt-4">
        <ScoreTable
          client:visible
          rows={program.courses}
          showFilters={false}
          compact={true}
          defaultSortKey="starisk"
        />
      </div>
    </section>

    <section class="mt-10 space-y-3 text-sm text-base-content/60">
      <p>
        {program.scored} of {program.total} courses are scored
        {program.programRating == null
          ? ', and the card above averages them, weighting each course by the reviews we read, so a course with four readable reviews does not pull as hard as one with twenty'
          : ''}. It is still a small sample: {program.reviews} reviews across the course pages.
      </p>
      {
        program.programRating != null && (
          <p>
            The program page has a rating of its own: Coursera lists it at{' '}
            <strong
              >{program.programCoursera == null ? '—' : program.programCoursera.toFixed(1)}</strong
            >, and the most-upvoted reviews of that page put it at{' '}
            <strong>{program.programRating.toFixed(1)}</strong>. That is the same comparison as on a
            course page, applied to the bundle.
          </p>
        )
      }
      <p>
        This is the same measurement as everywhere else on the site — what the most-upvoted reviews
        say — not a verdict on the program as a product.
        <a class="link link-hover" href="/method">The method.</a>
      </p>
    </section>
  </article>
</Base>
