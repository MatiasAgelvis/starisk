---
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import ScoreTable from '../../components/ScoreTable.svelte';
import ScoreGap from '../../components/ScoreGap.astro';
import RatingBar from '../../components/RatingBar.astro';
import Stars from '../../components/Stars.astro';
import { verdictOf, VERDICT } from '../../lib/verdict.js';
import { buildGroupings, typeLabel } from '../../lib/groupings.js';
import scores from '../../data/scores.json';
import groupings from '../../data/groupings.json';

export function getStaticPaths() {
  return buildGroupings(groupings, scores).map((program) => ({
    params: { slug: program.key },
    props: { program },
  }));
}

const { program } = Astro.props;
const average = program.average;
const type = typeLabel(program.type);
// A program has no written reviews of its own, so the comparison only exists for
// complete sets: a partial average would be one or two courses held up against
// the bundle's whole rating population.
const comparable = program.complete && program.coursera != null && average != null;
const verdict = comparable ? VERDICT[verdictOf(program.coursera, average)].label : '';
const ratings = program.ratings;
// Why the set is short matters: never-read is a crawl away, no-written-reviews is
// Coursera's answer and may never change.
const missing = program.total - program.scored;
const reasons = [
  program.unread ? `${program.unread} not read yet` : null,
  program.noReviews ? `${program.noReviews} with no written reviews` : null,
].filter(Boolean);
const description =
  average == null
    ? `${program.title}: ${program.total} courses, none with written reviews yet.`
    : `${program.title}: ${program.scored} courses averaged at ${average.toFixed(1)} out of 5.`;
---

<Base title={`${program.title} — Starisk`} description={description}>
  <article class="mx-auto max-w-3xl">
    <BackLink fallback="/programs" />

    <header class="mt-4">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="font-display text-3xl font-bold tracking-tight">{program.title}</h1>
        <span class="badge badge-ghost badge-sm">{type}</span>
      </div>
      <p class="mt-1 text-sm text-base-content/60">
        {program.provider ?? 'Unknown provider'} ·{' '}
        <a
          class="link link-hover"
          href={program.url}
          target="_blank"
          rel="noopener noreferrer">View on Coursera ↗</a
        >
      </p>
      {
        program.instructors.length > 0 && (
          <p class="mt-2 text-sm text-base-content/60">
            Taught by{' '}
            {program.instructors.slice(0, 6).map((person, index) => (
              <>
                {index > 0 ? ', ' : ''}
                <a class="link link-hover" href={`/instructors/${person.page}`}>
                  {person.name}
                </a>
              </>
            ))}
            {program.instructors.length > 6 ? ` and ${program.instructors.length - 6} more` : ''}
          </p>
        )
      }
    </header>

    {
      !program.complete && (
        <div class="alert alert-warning mt-6 text-sm">
          <span>
            <strong>Partial set.</strong> {program.total - program.scored} of {program.total}{' '}
            courses have no Starisk score, so this program is hidden from the default directory.
          </span>
        </div>
      )
    }

    {
      comparable ? (
        <div class="mt-6">
          <ScoreGap
            coursera={program.coursera}
            starisk={average}
            verdict={`${verdict} · average of ${program.scored} courses`}
          />
        </div>
      ) : (
        <div class="mt-6 rounded-box border border-base-300 bg-base-200/50 p-5">
          <div class="text-xs font-semibold uppercase tracking-wide text-base-content/50">
            Course average
          </div>
          <div class="mt-1 flex items-baseline gap-2">
            <span class="font-display text-3xl font-bold">
              {average == null ? '—' : average.toFixed(1)}
            </span>
            {average == null ? null : <Stars value={average} size={16} />}
          </div>
          <div class="text-xs text-base-content/50">
            across {program.scored} scored courses
            {program.complete ? '' : ' · incomplete set, not compared'}
          </div>
        </div>
      )
    }

    {
      program.ratingCounts != null && (
        <RatingBar counts={program.ratingCounts} ratings={program.ratings} class="mt-3" />
      )
    }

    <section class="mt-8">
      <h2 class="font-display text-xl font-bold">
        The {program.total === 1 ? 'course' : 'courses'}
      </h2>
      <div class="mt-4">
        <ScoreTable
          client:visible
          rows={program.courses}
          showFilters={false}
          compact={true}
          defaultSortKey="starisk"
        />
      </div>
    </section>

    <section class="mt-10 space-y-3 text-sm text-base-content/60">
      <p>
        {program.scored} of {program.total} courses are scored. The average weights each course by the
        reviews we actually read, so a course with four readable reviews does not pull as hard as one
        with twenty: {program.reviews} reviews across the course pages.
      </p>
      {
        program.coursera != null && (
          <p>
            Coursera rates the program itself at <strong>{program.coursera.toFixed(1)}</strong>
            {ratings == null ? '' : ` from ${ratings.toLocaleString()} ratings`}. That number is
            pooled across the bundle's courses; ours is the written reviews of those same courses.
            Same bundle, different population — there are no program-level written reviews to read.
          </p>
        )
      }
      {
        !program.complete && (
          <p>
            This set is incomplete, so the two numbers are not compared: {missing} of its courses
            have no Starisk score yet{reasons.length ? ` — ${reasons.join(', ')}` : ''}.
          </p>
        )
      }
      <p>
        A program is a grouping of courses — the same measurement as everywhere else on the site, cut
        by the bundle that contains the course.
        <a class="link link-hover" href="/method">The method.</a>
      </p>
    </section>
  </article>
</Base>
