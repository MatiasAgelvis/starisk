---
import Base from '../../layouts/Base.astro';
import GroupingTable from '../../components/GroupingTable.svelte';
import { buildGroupings } from '../../lib/groupings.js';
import scores from '../../data/scores.json';
import groupings from '../../data/groupings.json';

const programs = buildGroupings(groupings, scores);
const completePrograms = programs.filter((program) => program.complete).length;

// The island only needs the columns it draws; shipping every course in every
// program would bloat the page for no benefit. The drawer does need the member
// courses, trimmed to the fields the compact table renders (~140 rows in total).
const rows = programs.map((program) => ({
  key: program.key,
  title: program.title,
  type: program.type,
  provider: program.provider,
  image: program.image,
  // The program page's own numbers: Coursera's pooled rating for the bundle and
  // the population behind it. The score is the review-weighted average of the
  // courses inside — never anything from a program page's review widget, which
  // belongs to whichever course is selected.
  coursera: program.coursera,
  starisk: program.average,
  ratings: program.ratings,
  average: program.average,
  scored: program.scored,
  total: program.total,
  complete: program.complete,
  reviews: program.reviews,
  noReviews: program.noReviews,
  unread: program.unread,
  // The drawer lists a handful of names; the program page lists them all.
  instructors: program.instructors.slice(0, 4),
  instructorCount: program.instructors.length,
  courses: program.courses.map((course) => ({
    key: course.key,
    title: course.title,
    provider: course.provider,
    image: course.image,
    coursera: course.coursera,
    starisk: course.starisk,
    low: course.low_sample === true,
    // The drawer folds never-crawled members, so it has to know which they are.
    read: course.read,
  })),
}));
---

<Base
  title="Programs — Starisk"
  description="Specializations and Professional Certificates, with the courses they contain and the average score of those courses."
>
  <article class="mx-auto max-w-4xl">
    <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Programs</h1>
    <p class="mt-3 max-w-2xl text-base-content/70">
      A specialization or Professional Certificate is a bundle of courses. This page answers the
      obvious next question: <strong>does the bundle hold up?</strong>
    </p>
    <p class="mt-2 max-w-2xl text-sm text-base-content/60">
      A program has no written reviews of its own, so its Starisk score is the
      <strong>review-weighted average of its courses</strong>: a course with twenty readable reviews pulls
      harder than one with four. The <strong>Gap</strong> compares that against Coursera's bundled rating for
      the program — two bundle-level numbers, from different populations.
    </p>
    <p class="mt-2 max-w-2xl text-sm text-base-content/60">
      Only <strong>complete sets</strong> are shown by default: every course in the program has a
      Starisk score. The toggle shows how many partial programs are hidden.
    </p>

    <div class="mt-8">
      <GroupingTable client:load rows={rows} pageSize={50} />
    </div>

    <section class="mt-10 space-y-3 text-sm text-base-content/60">
      <p>
        {programs.length} programs; {completePrograms} complete. A course can belong to more than
        one program; each membership is counted separately.
      </p>
      <p>
        None of this is a rating of the program as a product. It is the same measurement as
        everywhere else on the site — what the most-upvoted reviews say — re-cut by the program
        that contains the course.
        <a class="link link-hover" href="/method">The method, with the numbers.</a>
      </p>
    </section>
  </article>
</Base>
