---
import Base from '../../layouts/Base.astro';
import GroupingTable from '../../components/GroupingTable.svelte';
import { buildGroupings } from '../../lib/groupings.js';
import scores from '../../data/scores.json';
import groupings from '../../data/groupings.json';

const programs = buildGroupings(groupings, scores);
const scoredPrograms = programs.filter((program) => program.average != null).length;

// The island only needs the columns it draws; shipping every course in every
// program would bloat the page for no benefit.
const rows = programs.map((program) => ({
  key: program.key,
  title: program.title,
  type: program.type,
  provider: program.provider,
  scored: program.scored,
  total: program.total,
  average: program.average,
  low: program.low,
  high: program.high,
  reviews: program.reviews,
}));
---

<Base
  title="Programs — Starisk"
  description="Specializations and Professional Certificates, with the courses they contain and the average score of those courses."
>
  <article class="mx-auto max-w-4xl">
    <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Programs</h1>
    <p class="mt-3 max-w-2xl text-base-content/70">
      A specialization or Professional Certificate is a bundle of courses. This page answers the
      obvious next question: <strong>does the bundle hold up?</strong>
    </p>
    <p class="mt-2 max-w-2xl text-sm text-base-content/60">
      The average weights each course by the reviews we actually read, matching the teacher
      directory. Courses with no written reviews stay in the list but do not pull on the average.
      Where the program page itself has a review score, its page shows that umbrella rating next
      to the course average.
    </p>

    <div class="mt-8">
      <GroupingTable client:load rows={rows} />
    </div>

    <section class="mt-10 space-y-3 text-sm text-base-content/60">
      <p>
        {programs.length} programs, {scoredPrograms} with at least one scored course. A course can
        belong to more than one program; each membership is counted separately.
      </p>
      <p>
        None of this is a rating of the program as a product. It is the same measurement as
        everywhere else on the site — what the most-upvoted reviews say — re-cut by the program
        that contains the course.
        <a class="link link-hover" href="/method">The method, with the numbers.</a>
      </p>
    </section>
  </article>
</Base>
