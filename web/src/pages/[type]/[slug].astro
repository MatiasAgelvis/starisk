---
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import Stars from '../../components/Stars.astro';
import ScoreGap from '../../components/ScoreGap.astro';
import RatingBar from '../../components/RatingBar.astro';
import Logo from '../../components/Logo.astro';
import { verdictOf, VERDICT } from '../../lib/verdict.js';
import { buildMemberships } from '../../lib/groupings.js';
import groupings from '../../data/groupings.json';
import { courses, isScoredEntry } from '../../lib/courses.js';
import { CELLS, TOO_FEW, cellOf, spreadShareBelow } from '../../lib/contested.js';

export function getStaticPaths() {
  return Object.entries(courses)
    .filter(isScoredEntry)
    .map(([key, record]) => {
      const [type, slug] = key.split('/');
      return { params: { type, slug }, props: { record, key } };
    });
}

const { record, key } = Astro.props;
const inflation = record.coursera == null ? null : record.coursera - record.starisk;
const top = record.top_review;
const title = record.title ?? key;

// Where this course sits on the score-vs-disagreement plot. The share is of
// courses with a lower spread, so a high value means the reviews scatter more.
const spread = typeof record.spread === 'number' ? record.spread : null;
const spreadCell = spread == null ? null : cellOf(record.starisk, spread, record.reviews ?? 0);
const tooFew = spreadCell === 'tooFew';
const spreadLabel = spreadCell
  ? tooFew
    ? TOO_FEW.label
    : (CELLS.find((cell) => cell.id === spreadCell)?.label ?? null)
  : null;
const spreadTop =
  spread == null || tooFew
    ? null
    : Math.max(1, Math.round((1 - spreadShareBelow(spread)) * 100));

const description =
  record.coursera == null
    ? `${title}: the most-upvoted learner reviews put it at ${record.starisk.toFixed(1)} out of 5.`
    : `${title}: Coursera rates it ${record.coursera.toFixed(1)}, the most-upvoted reviews say ${record.starisk.toFixed(1)}.`;

const readOn = record.scrapedAt
  ? new Date(record.scrapedAt).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    })
  : null;

const instructors = record.instructors ?? [];
const categories = record.categories ?? [];

// The other half of the program relationship: this course's bundles. Built at
// build time from the same index the programs directory uses.
const memberships = buildMemberships(groupings, courses).get(key) ?? [];

// Coursera publishes its whole rating distribution in the page data. That is the
// population — every rating ever — and it is more honest than any sample we read.
const counts = record.rating_counts ?? null;
const ratingsTotal =
  record.ratings_total ?? (counts ? Object.values(counts).reduce((a, b) => a + b, 0) : null);

function verdictText() {
  if (inflation == null) return 'No headline rating to compare';
  return VERDICT[verdictOf(record.coursera, record.starisk)].label;
}

function votes(count: number) {
  return count === 0 ? 'no upvotes' : `${count} ${count === 1 ? 'vote' : 'votes'}`;
}

// Coursera collapses this block behind a "show more". We keep the whole text but
// collapse it the same way, cutting on a sentence boundary instead of a pixel
// height or a character count — a preview that stops mid-word reads as broken.
const aboutText = (record.description ?? '').trim();
const TARGET = 260;

function splitDescription(text: string) {
  if (text.length <= TARGET + 120) return { head: text, tail: '' };
  const found = text.slice(TARGET).search(/[.!?](?=\s)/);
  // No sentence end to cut on: show everything rather than truncate mid-word.
  if (found === -1) return { head: text, tail: '' };
  const cut = TARGET + found + 1;
  return { head: text.slice(0, cut).trim(), tail: text.slice(cut).trim() };
}

const about = splitDescription(aboutText);
---

<Base title={`${record.title ?? key} — Starisk`} description={description}>
  <article class="mx-auto max-w-3xl">
    <BackLink fallback="/" />

    <header class="mt-4 flex items-start gap-4">
      <Logo src={record.image} full class="mt-1 h-20 w-20 sm:h-28 sm:w-28" />
      <div class="min-w-0">
        <h1 class="font-display text-3xl font-bold tracking-tight">
          {record.title ?? key}
        </h1>
        <p class="mt-1 text-sm text-base-content/60">
          {record.provider ?? 'Unknown provider'} ·{' '}
          <a
            class="link link-hover"
            href={`https://www.coursera.org/${key}`}
            target="_blank"
            rel="noopener noreferrer">View on Coursera ↗</a
          >
        </p>
        <p class="mt-1 text-xs text-base-content/50">
          <a class="link link-hover" href="/bookmarklet">Or see the score while you browse.</a>
        </p>
        {
          instructors.length > 0 && (
            <p class="mt-1 text-sm text-base-content/60">
              Taught by{' '}
              {instructors.map((person, index) => (
                <>
                  {index > 0 ? ', ' : ''}
                  <a class="link link-hover" href={`/instructors/${person.page}`}>
                    {person.name}
                  </a>
                </>
              ))}
            </p>
          )
        }
        {
          categories.length > 0 && (
            <p class="mt-2 flex flex-wrap gap-1">
              {categories.map((category) => (
                <span class="badge badge-ghost badge-sm">{category}</span>
              ))}
            </p>
          )
        }
      </div>
    </header>

    {
      memberships.length > 0 && (
        <p class="mt-3 text-sm text-base-content/60">
          Part of {memberships.length} {memberships.length === 1 ? 'program' : 'programs'}:{' '}
          {memberships.map((program, index) => (
            <>
              {index > 0 ? ' · ' : ''}
              <a class="link link-hover" href={`/programs/${program.key}`}>
                {program.title}
              </a>
            </>
          ))}
        </p>
      )
    }

    <div class="mt-6">
      <ScoreGap
        coursera={record.coursera ?? null}
        starisk={record.starisk}
        verdict={verdictText()}
      />
    </div>

    {counts != null && <RatingBar counts={counts} ratings={ratingsTotal} class="mt-3" />}

    {
      spread != null && spreadLabel && (
        <p class="mt-3 flex flex-wrap items-center gap-2 text-sm text-base-content/60">
          <span class="badge badge-ghost badge-sm">
            {spreadLabel} · spread {spread.toFixed(1)}
          </span>
          <span>
            {tooFew
              ? `Only ${record.reviews} readable ${record.reviews === 1 ? 'review' : 'reviews'}, so there is no consensus label.`
              : `Top ${spreadTop}% by disagreement across ${record.reviews} reviews.`}{' '}
            <a class="link link-hover" href="/findings#contested">What this means</a>
          </span>
        </p>
      )
    }

    {
      record.low_sample && (
        <div class="alert alert-warning mt-6 text-sm">
          <span>
            <strong>Small sample.</strong> Only {record.reviews}{
              record.reviews === 1 ? ' review was' : ' reviews were'
            } readable
            {record.source === 'jsonld' ? ' and they carry no upvotes' : ''}, so this score
            is a hint, not a verdict. Every other course page reads about 20 of the
            most-helpful reviews.
          </span>
        </div>
      )
    }

    {
      about.head && (
        <section class="mt-8">
          <h2 class="font-display text-xl font-bold">About the course</h2>
          <p class="mt-2 whitespace-pre-line text-base-content/80">{about.head}</p>
          {about.tail && (
            <details class="mt-2">
              <summary class="cursor-pointer text-sm text-base-content/60 hover:text-base-content">
                Read more
              </summary>
              <p class="mt-2 whitespace-pre-line text-base-content/80">{about.tail}</p>
            </details>
          )}
        </section>
      )
    }

    {
      top && top.text && (
        <section class="mt-8">
          <h2 class="font-display text-xl font-bold">
            {top.kind === 'consensus' ? 'The consensus' : 'The dissent'}
          </h2>
          <p class="mt-1 text-sm text-base-content/60">
            {top.kind === 'consensus'
              ? 'The most-upvoted review.'
              : 'The most-upvoted critical review.'}
          </p>
          <figure
            class="relative mt-6 rounded-box bg-base-200 py-5 pl-12 pr-5 sm:py-8 sm:pl-16 sm:pr-8"
          >
            <span
              aria-hidden="true"
              class="pointer-events-none absolute left-4 top-3 select-none font-display text-4xl leading-none text-[var(--chart-ours)] opacity-40 sm:left-7 sm:top-5 sm:text-6xl"
              >“</span
            >
            <blockquote
              class="font-display text-lg leading-relaxed text-base-content/90 sm:text-xl"
            >
              {top.text}
            </blockquote>
            <figcaption
              class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-base-300/70 pt-4 text-sm"
            >
              <span class="inline-flex items-center gap-1.5 text-base-content/80">
                <Stars value={top.stars} size={14} />
                <span class="font-mono font-semibold">{top.stars.toFixed(1)}</span>
                <span class="text-base-content/50">/ 5</span>
              </span>
              <span class="text-base-content/70">{votes(top.likes)}</span>
              <a
                class="link link-hover text-base-content/70 sm:ml-auto"
                href={`https://www.coursera.org/${key}/reviews`}
                target="_blank"
                rel="noopener noreferrer"
              >
                {top.text.endsWith('…') ? 'Read the full review' : 'The review'} on Coursera ↗
              </a>
            </figcaption>
          </figure>
        </section>
      )
    }

    <section class="mt-8 border-t border-base-300 pt-4">
      <div class="grid gap-x-10 gap-y-2 sm:grid-cols-[1fr_auto]">
        <p class="max-w-prose text-sm leading-relaxed text-base-content/60">
          Scores come from the reviews learners voted most helpful, not a verdict on
          quality — see{' '}
          <a class="link link-hover font-medium text-base-content/90" href="/method"
            >the method</a
          >.
        </p>
        {
          readOn && (
            <p class="text-xs text-base-content/45 sm:pt-1 sm:text-right">
              Reviews read on {readOn}
            </p>
          )
        }
      </div>
    </section>
  </article>
</Base>
