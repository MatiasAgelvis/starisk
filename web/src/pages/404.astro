---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — Starisk" description="That page doesn't exist.">
  <section class="py-16 text-center">
    <p class="font-display text-6xl text-warning" aria-hidden="true">*</p>
    <h1 class="font-display mt-4 text-3xl font-bold">No score for this page</h1>
    <p class="mx-auto mt-3 max-w-md text-base-content/70">
      It may not exist, or the course hasn't been crawled yet — Starisk only scores
      courses it has actually read.
    </p>
    <a href="/" class="btn btn-neutral mt-6">Back to the leaderboard</a>
  </section>
</Base>
