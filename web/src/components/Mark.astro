---
interface Props {
  class?: string;
  title?: string;
}

const { class: className = 'h-4 w-4', title } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="3.2"
  stroke-linecap="round"
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
>
  {title ? <title>{title}</title> : null}
  <path d="M16 7.5v17" />
  <path d="M8.6 11.7l14.8 8.6" />
  <path d="M23.4 11.7l-14.8 8.6" />
</svg>
