---
import '../styles/global.css';
import { STAR_PATH } from '../lib/stars.js';
import { courses } from '../lib/courses.js';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Starisk',
  description = 'What learners actually say about Coursera courses, weighted by the votes their reviews received.',
} = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;

// Three sections plus one grouped pair, not five tabs on one page: the URL is
// what people share. The leaderboard is the home page, so "Courses" points at
// `/`. Findings and Method are the same argument at two depths — what the corpus
// says, and how it was measured — so they share a menu rather than growing the
// top level again.
// Astro's pathname carries a trailing slash on some routes (`/method/`), so
// normalise before comparing — otherwise the active tab silently disappears.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCourses = path === '/' || /^\/(learn|specializations|professional-certificates)\//.test(path);
const isPrograms = path.startsWith('/programs');
const isTeachers = path.startsWith('/instructors');
const isFindings = path.startsWith('/findings');
const isMethod = path.startsWith('/method');
const isEvidence = isFindings || isMethod;

// The footer's freshness line comes from the data itself: the newest
// `scrapedAt` in the corpus. A build with stale data should say so rather than
// pretend the site is live.
const records = Object.values(courses);
const lastCrawl = records
  .map((record) => record.scrapedAt)
  .filter(Boolean)
  .sort()
  .at(-1);
const scoredCount = records.filter((record) => typeof record.starisk === 'number').length;
const lastCrawlDate = lastCrawl
  ? new Intl.DateTimeFormat('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(new Date(lastCrawl))
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/atom+xml" title="Starisk — wanted" href="/feed.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#111827" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('starisk-theme');
        if (theme === 'starisk' || theme === 'starisk-dark') {
          document.documentElement.dataset.theme = theme;
        }
      } catch {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Starisk" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <!-- Counter.dev: cookieless, ~1 KB, no personal data. Only in production so
         `astro dev` doesn't pollute the stats. See the privacy note in the footer. -->
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://cdn.counter.dev/script.js"
          data-id="0de1bf3d-1d12-4011-bf4d-485bfe73d701"
          data-utcoffset="2"
        />
      )
    }
  </head>
  <body>
    <!-- One star path for the whole page; every <Stars> references it. Repeating
         the path per glyph costs ~1 MB of HTML on a full leaderboard. -->
    <svg width="0" height="0" aria-hidden="true" focusable="false" class="absolute">
      <symbol id="star" viewBox="0 0 24 24">
        <path d={STAR_PATH} />
      </symbol>
    </svg>

    <div class="navbar bg-base-200">
      <div class="navbar-start">
        <a href="/" class="btn btn-ghost text-xl font-display">
          <img src="/favicon.svg" alt="" class="h-5 w-5" />
          <span class="hidden sm:inline">Starisk</span>
        </a>
      </div>
      <div class="navbar-end gap-1">
        <a
          href="/"
          class={`btn btn-ghost btn-sm px-2 text-sm sm:px-3 ${isCourses ? 'btn-active' : ''}`}
          aria-current={isCourses ? 'page' : undefined}>Courses</a
        >
        <a
          href="/programs"
          class={`btn btn-ghost btn-sm px-2 text-sm sm:px-3 ${isPrograms ? 'btn-active' : ''}`}
          aria-current={isPrograms ? 'page' : undefined}>Programs</a
        >
        <a
          href="/instructors"
          class={`btn btn-ghost btn-sm px-2 text-sm sm:px-3 ${isTeachers ? 'btn-active' : ''}`}
          aria-current={isTeachers ? 'page' : undefined}>Teachers</a
        >
        <!-- A <details> dropdown, so the menu still works with JavaScript off and
             the links stay in the HTML for crawlers. The inline script at the end
             of the body only adds the dismissal behaviour a popover would give us:
             click outside or press Escape. -->
        <details class="dropdown dropdown-end group nav-menu">
          <summary
            class={`btn btn-ghost btn-sm list-none gap-1 px-2 text-sm sm:px-3 ${isEvidence
              ? 'btn-active'
              : ''}`}
          >
            Evidence
            <svg
              class="h-3 w-3 opacity-60 transition-transform duration-200 group-open:rotate-180"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg
            >
          </summary>
          <ul
            class="menu dropdown-content z-50 mt-2.5 w-60 rounded-box border border-base-300/70 bg-base-100 p-1.5 shadow-xl"
          >
            <li>
              <a
                href="/findings"
                class={`gap-2 py-2 pr-3${isFindings ? ' font-medium' : ''}`}
                aria-current={isFindings ? 'page' : undefined}
              >
                <span class="flex flex-col gap-0.5">
                  <span>Findings</span>
                  <span class="text-xs font-normal opacity-60">Where our scores diverge</span>
                </span>
              </a>
            </li>
            <li>
              <a
                href="/method"
                class={`gap-2 py-2 pr-3${isMethod ? ' font-medium' : ''}`}
                aria-current={isMethod ? 'page' : undefined}
              >
                <span class="flex flex-col gap-0.5">
                  <span>Method</span>
                  <span class="text-xs font-normal opacity-60">How a course gets its score</span>
                </span>
              </a>
            </li>
          </ul>
        </details>
        <label class="btn btn-ghost btn-sm px-2 sm:px-3" title="Toggle theme">
          <span class="swap swap-rotate">
            <input type="checkbox" data-theme-toggle aria-label="Toggle dark mode" />
            <svg
              class="swap-on h-5 w-5 fill-current"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
            >
              <path
                d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z"
              />
            </svg>
            <svg
              class="swap-off h-5 w-5 fill-current"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
            >
              <path
                d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z"
              />
            </svg>
          </span>
        </label>
      </div>
    </div>

    <main class="container mx-auto max-w-5xl px-4 py-8">
      <slot />
    </main>

    <footer class="mt-16 border-t border-base-300">
      <div class="container mx-auto max-w-5xl px-4 py-10 text-sm text-base-content/60">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
          <div>
            <a
              href="/"
              class="inline-flex items-center gap-2 font-display text-base font-semibold text-base-content"
            >
              <img src="/favicon.svg" alt="" class="h-4 w-4" />
              Starisk
            </a>
            <p class="mt-2 max-w-xs">The true signal, under the rating.</p>
            {
              lastCrawlDate && (
                <p class="mt-3 text-xs text-base-content/50">
                  Last crawl <time datetime={lastCrawl}>{lastCrawlDate}</time> · {scoredCount}{
                    ' '
                  }courses scored. <a class="link link-hover mt-1 block w-fit" href="/method">How are scores made?</a>
                </p>
              )
            }
          </div>

          <nav aria-label="Explore">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-base-content/50">
              Explore
            </p>
            <ul class="space-y-1">
              <li><a class="link link-hover" href="/">Courses</a></li>
              <li><a class="link link-hover" href="/programs">Programs</a></li>
              <li><a class="link link-hover" href="/instructors">Teachers</a></li>
            </ul>
          </nav>

          <nav aria-label="Evidence">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-base-content/50">
              Evidence
            </p>
            <ul class="space-y-1">
              <li><a class="link link-hover" href="/findings">Findings</a></li>
              <li><a class="link link-hover" href="/method">Method</a></li>
              <li><a class="link link-hover" href="/background">Background</a></li>
              <li><a class="link link-hover" href="/about">About</a></li>
            </ul>
          </nav>

          <nav aria-label="Data">
            <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-base-content/50">
              Data
            </p>
            <ul class="space-y-1">
              <li><a class="link link-hover" href="/wanted">Wanted</a></li>
              <li><a class="link link-hover" href="/feed.xml">RSS</a></li>
              <li><a class="link link-hover" href="/data/scores.json">Dataset</a></li>
              <li>
                <a
                  class="link link-hover"
                  href="https://github.com/MatiasAgelvis/starisk"
                  target="_blank"
                  rel="noopener noreferrer">Source ↗</a
                >
              </li>
            </ul>
          </nav>
        </div>

        <div
          class="mt-10 flex flex-col gap-2 border-t border-base-300 pt-4 text-xs text-base-content/40 sm:flex-row sm:items-center sm:justify-between"
        >
          <p>Ratings computed from Coursera reviews. Not affiliated with Coursera.</p>
          <p>Cookie-free visit counts.</p>
        </div>
      </div>
    </footer>

    <!-- A <details> menu stays open until its summary is clicked again, which is
         fine for a menu but not for a popover. Close it the way people expect:
         click anywhere else, or press Escape (returning focus to the trigger). -->
    <script>
      const menu = document.querySelector('details.nav-menu');
      const trigger = menu?.querySelector('summary');
      if (menu && trigger) {
        document.addEventListener('click', (event) => {
          if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && menu.open) {
            menu.open = false;
            trigger.focus();
          }
        });
      }
    </script>

    <script>
      const THEME_KEY = 'starisk-theme';
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLInputElement>('[data-theme-toggle]');
      const media = window.matchMedia('(prefers-color-scheme: dark)');

      const readTheme = () => {
        try {
          const theme = localStorage.getItem(THEME_KEY);
          return theme === 'starisk' || theme === 'starisk-dark' ? theme : null;
        } catch {
          return null;
        }
      };

      const sync = () => {
        if (!toggle) return;
        const stored = readTheme();
        toggle.checked = stored ? stored === 'starisk-dark' : media.matches;
      };

      sync();

      toggle?.addEventListener('change', () => {
        const next = toggle.checked ? 'starisk-dark' : 'starisk';
        root.dataset.theme = next;
        try {
          localStorage.setItem(THEME_KEY, next);
        } catch {}
      });

      media.addEventListener('change', (event) => {
        if (readTheme()) return;
        root.removeAttribute('data-theme');
        if (toggle) toggle.checked = event.matches;
      });
    </script>
  </body>
</html>
