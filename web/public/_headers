# Cloudflare Pages headers. Ignored by hosts that don't read this file.
# CORS is already `*` on both GH Pages and CF Pages; this makes the JSON's
# freshness explicit so a crawl shows up quickly without hammering the CDN.

/data/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
